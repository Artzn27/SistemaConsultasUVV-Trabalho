@model RegistroViewModel
@{
    ViewData["Title"] = "Criar Conta";
}

<h1>Criar Conta</h1>

<form asp-controller="Conta" asp-action="Registrar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <label asp-for="Nome"></label>
    <input asp-for="Nome" />
    <span asp-validation-for="Nome" class="text-danger"></span>

    <label asp-for="Email"></label>
    <input asp-for="Email" type="email" />
    <span asp-validation-for="Email" class="text-danger"></span>

    <label asp-for="Senha"></label>
    <input asp-for="Senha" type="password" />
    <span asp-validation-for="Senha" class="text-danger"></span>

    <label asp-for="ConfirmarSenha"></label>
    <input asp-for="ConfirmarSenha" type="password" />
    <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>

    <button type="submit">Cadastrar</button>
</form>

<p>Já tem conta? <a asp-controller="Conta" asp-action="Login">Entrar</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
